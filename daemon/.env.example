# OpenPisoWiFi - Hardware Daemon Environment Configuration
# Internal API port for Next.js communication
PORT=4000

# Next.js Captive Portal Port (Native Port 80 redirect target)
PORTAL_PORT=3000
PORTAL_DOMAIN=wifi.local
PORTAL_IP=192.168.1.240

# OpenWrt Router SSH & Controller Settings
ROUTER_IP=192.168.1.1
ROUTER_SSH_PORT=22
ROUTER_SSH_USER=root
ROUTER_SSH_KEY_PATH=/root/.ssh/id_rsa
ROUTER_MODE=fw4_nftables

# Coin Slot Physical GPIO Pin (BCM Pin)
# BCM 2 = Physical Pin 3 (WiringPi 8) — SDA1; ensure no I2C device is wired
COIN_GPIO_PIN=2

# Inhibit Pin GPIO (BCM Pin)
# BCM 3 = Physical Pin 5 (WiringPi 9) — SCL1; ensure no I2C device is wired
INHIBIT_GPIO_PIN=3

# Inhibit Pin Mode (true = Default HIGH / Built-in Inhibit, false = Default LOW / Relay Mode)
# Default HIGH: Idle = 3.3V HIGH (blocked), Insert Coin = 0V LOW (accepting) — for CL-168/Allan SET pins
# Default LOW: Idle = 0V LOW (relay off/cut), Insert Coin = 3.3V HIGH (relay on) — for external relay modules
INHIBIT_ACTIVE_HIGH=true

# Seconds coin slot stays active after "Insert Coin" press before auto-inhibiting
# Timer resets on each coin drop. Default: 90 seconds
COIN_SLOT_TIMEOUT_SECONDS=90

# --- Telegram Bot Remote Administration (Optional / Free via Telegram API) ---
# Create a bot via @BotFather on Telegram and get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Supabase Cloud Sync (Optional / Free PostgreSQL Cloud Database) ---
# Get project URL and anon/service_role key from your Supabase Dashboard
SUPABASE_URL=
SUPABASE_KEY=
MACHINE_ID=openpiso-kiosk-1

# --- Satellite Multi-Coinslot & Security Authentication ---
# Shared secret token required for ESP32 satellites to register, send pulses, and receive unlock commands
SATELLITE_SECRET=change-me-to-a-secure-random-secret
# Set to 'true' only if you want to allow simulated coin insertions via localhost (development only)
ENABLE_COIN_SIMULATOR=false
# IP interface for daemon to bind (0.0.0.0 or 127.0.0.1 for local Pi)
DAEMON_HOST=0.0.0.0


