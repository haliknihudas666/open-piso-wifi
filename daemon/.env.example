# OpenPisoWiFi - Hardware Daemon Environment Configuration
# Internal API port for Next.js communication
PORT=4000

# Next.js Captive Portal Port (Native Port 80 redirect target)
PORTAL_PORT=3000
PORTAL_DOMAIN=wifi.local
PORTAL_IP=192.168.1.240

# OpenWrt Router SSH & Controller Settings
ROUTER_IP=192.168.1.1
ROUTER_SSH_PORT=22
ROUTER_SSH_USER=root
ROUTER_SSH_KEY_PATH=/root/.ssh/id_rsa
ROUTER_MODE=fw4_nftables

# Coin Slot Physical GPIO Pin (Canonical BCM Pin Number)
# BCM 4 = Physical Pin 7 (avoids hardwired 1.8kΩ I2C pull-ups on BCM 2/3)
COIN_GPIO_PIN=4

# Inhibit Pin GPIO (Canonical BCM Pin Number)
# BCM 17 = Physical Pin 11
INHIBIT_GPIO_PIN=17

# Physical "Insert Coin" Push Button GPIO (Canonical BCM Pin Number)
# BCM 27 = Physical Pin 13
BUTTON_GPIO_PIN=27

# GPIO Backend & Board Profile
# GPIO_BACKEND: auto | gpiozero | gpiod | serial
# BOARD_PROFILE: rpi | orangepi | nanopi | x86_serial
GPIO_BACKEND=auto
BOARD_PROFILE=rpi

# Pulse-to-Peso Multiplier (1 for coin acceptors, >1 for bill acceptors)
PULSE_MULTIPLIER=1

# Optional Linux USB Serial Coin Bridge (for firmware/esp32-coin-bridge on x86_64/Mini PC)
# Example: /dev/ttyUSB0
SERIAL_COIN_PORT=

# Inhibit Pin Mode (true = Default HIGH / Built-in Inhibit, false = Default LOW / Relay Mode)
# Default HIGH: Idle = 3.3V HIGH (blocked), Insert Coin = 0V LOW (accepting) — for CL-168/Allan SET pins
# Default LOW: Idle = 0V LOW (relay off/cut), Insert Coin = 3.3V HIGH (relay on) — for external relay modules
INHIBIT_ACTIVE_HIGH=true

# Seconds coin slot stays active after "Insert Coin" press before auto-inhibiting
# Timer resets on each coin drop. Default: 90 seconds
COIN_SLOT_TIMEOUT_SECONDS=90

# --- Telegram Bot Remote Administration (Optional / Free via Telegram API) ---
# Create a bot via @BotFather on Telegram and get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Cloudflare Tunnel Remote Admin Access (Optional / Free via trycloudflare.com) ---
# Set CLOUDFLARE_TUNNEL_ENABLED=true to auto-start Quick Tunnel on boot.
# Leave CLOUDFLARE_TUNNEL_TOKEN empty for zero-setup Quick Tunnels, or set a Named Tunnel token.
CLOUDFLARE_TUNNEL_ENABLED=false
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_TUNNEL_HOSTNAME=
MACHINE_ID=openpiso-kiosk-1

# --- Internal Trust Boundary, OpenPiso Shield & Satellite Authentication ---
# Shared secret between Portal and Daemon (must match portal/.env DAEMON_API_SECRET)
# Generate with: openssl rand -hex 32
DAEMON_API_SECRET=
# Shared secret required for ESP32 wireless satellites (generate with: openssl rand -hex 24)
# If left empty, daemon generates a random ephemeral secret at runtime
SATELLITE_SECRET=
# Optional dedicated secret for OpenWrt WIDS alerts -> POST /api/shield/wids-event
# Falls back to DAEMON_API_SECRET or SATELLITE_SECRET when unset
SHIELD_SECRET=
# Set to 'true' only if you want to allow simulated coin insertions via localhost (development only)
ENABLE_COIN_SIMULATOR=false
# IP interface for daemon to bind (0.0.0.0 for LAN ESP32 satellites, or 127.0.0.1 for local-only)
DAEMON_HOST=0.0.0.0


